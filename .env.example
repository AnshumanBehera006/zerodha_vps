# =================================================================
# Root Environment Configuration for VPS Deployment
# Copy this file to .env on your VPS and update the values:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# Environment Mode
# Set to 'production' when deploying with domains & HTTPS.
# If testing without SSL on plain HTTP/IP, set to 'development'
# so cookie security doesn't block unencrypted HTTP.
# -----------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------
# Database & Authentication
# -----------------------------------------------------------------
# MongoDB Connection String (Atlas URI or local mongodb)
MONGO_URL=mongodb+srv://anshumanbehera006_db_user:10P53WP2IXE4v4vv@zerodhaclonecluster.kozuuwu.mongodb.net/zerodha?retryWrites=true&w=majority
# JWT Secret Key for token signing
TOKEN_KEY=z3r0dha_cl0n3_sup3r_s3cr3t_k3y_2024

# -----------------------------------------------------------------
# Domain Configuration for Caddy (Reverse Proxy & Auto-HTTPS)
# Point your DNS A/AAAA records to your VPS IP address first!
# -----------------------------------------------------------------
FRONTEND_DOMAIN=zerodhaclone.duckdns.org
DASHBOARD_DOMAIN=dashboard.zerodhaclone.duckdns.org
API_DOMAIN=api.zerodhaclone.duckdns.org

# -----------------------------------------------------------------
# Public URLs (Used by Backend for CORS and Cookies)
# -----------------------------------------------------------------
FRONTEND_URL=https://zerodhaclone.duckdns.org
DASHBOARD_URL=https://dashboard.zerodhaclone.duckdns.org

# -----------------------------------------------------------------
# React Build-Time Environment Variables
# Injected into the frontend and dashboard production builds
# -----------------------------------------------------------------
REACT_APP_API_URL=https://api.zerodhaclone.duckdns.org
REACT_APP_DASHBOARD_URL=https://dashboard.zerodhaclone.duckdns.org
REACT_APP_FRONTEND_URL=https://zerodhaclone.duckdns.org

